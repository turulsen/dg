rules_version = '2';

// Not used until Phase 4 (Images/Storage) -- scaffolded now so
// `firebase deploy` has a valid target from Phase 1 onward. New
// uploads only (Handout photos, Face Plates, Evidence, Track library);
// existing gdrive: links are untouched by this migration.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
